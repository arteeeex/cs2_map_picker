/* Os cinco sao simetricos: qualquer subconjunto pode ser o lobby, inclusive um
   que nao inclua voce. Por isso cada partida guarda em que TIME cada um estava
   ('1' ou '2', '-' se nao jogou), e o placar e orientado na hora para o lado de
   quem esta marcado. Assim "so o KICK" usa as partidas dele sem voce. */
const PLAYERS = __PLAYERS__;
const EU = PLAYERS[0].id;

/* ------------------------------------------------- parametros do modelo */
const P = {
  halfLife: 480, maxAge: 3000, poolWindow: 240,
  wOutcome: 0.65, wRoundShare: 0.35,
  rosterFloor: 0.05, rosterGamma: 1.5,
  kGlobal: 10, kMap: 8, kRoster: 6,
  formBeta: 0.12, formShrink: 6,
  z: 1.645,
  perf: { kd:0.375, adr:0.375, rating:0.25 },   // CSStats nao expoe KAST
};

const NOW = Date.now() / 1000;

/* ------------------------------------------------------------ matematica */
const logit = p => { p = Math.min(Math.max(p,1e-6),1-1e-6); return Math.log(p/(1-p)); };
const sigmoid = x => x >= 0 ? 1/(1+Math.exp(-x)) : Math.exp(x)/(1+Math.exp(x));
const kish = ws => { const a=ws.reduce((s,w)=>s+w,0), b=ws.reduce((s,w)=>s+w*w,0);
                     return b > 1e-9 ? a*a/b : 0; };
const shrink = (mean,n,prior,k) => n <= 1e-9 ? prior : (n*mean + k*prior)/(n+k);
function wmean(pairs){ let num=0,den=0; for(const [v,w] of pairs){ if(v==null||w==null) continue;
  num+=v*w; den+=w; } return den>1e-9 ? num/den : null; }

/* --------------------------------------------------------------- parsing
   ts, mapIdx, roundsTime1, roundsTime2, times, premier, k, d, a, adr, hs, rating
   (as estatisticas individuais existem so nas partidas em que voce jogou)   */
const ROWS = RAW.trim().split("\n").map(line => {
  const p = line.split(",");
  return {
    ts:+p[0], map:MAPS[+p[1]], a:+p[2], b:+p[3],
    teams:p[4], premier:p[5] === "1",
    k:p[6]?+p[6]:null, d:p[7]?+p[7]:null, ast:p[8]?+p[8]:null,
    adr:p[9]?+p[9]:null, hs:p[10]?+p[10]:null,
    rating:p[11]?parseFloat(p[11]):null,
    age:(NOW - +p[0]) / 86400,
  };
});

PLAYERS.forEach((p,i) => { p.jogos = ROWS.filter(r => r.teams[i] !== "-").length; });

/* Orienta a partida para o lado de quem esta no lobby. Devolve null quando
   ninguem do lobby jogou, ou quando o lobby ficou dividido entre os dois times. */
function orient(r, lobby){
  let side = null;
  for(let i=0;i<PLAYERS.length;i++){
    const ch = r.teams[i];
    if(ch === "-" || !lobby.has(PLAYERS[i].id)) continue;
    if(side && side !== ch) return null;
    side = ch;
  }
  if(!side) return null;
  const roster = new Set();
  for(let i=0;i<PLAYERS.length;i++) if(r.teams[i] === side) roster.add(PLAYERS[i].id);
  return { rw: side==="1"?r.a:r.b, rl: side==="1"?r.b:r.a,
           roster, euJogou: r.teams[0] === side };
}

function build(halfLife, lobby){
  const ms = [];
  for(const r of ROWS){
    if(r.age > P.maxAge) continue;
    if(S.soPremier && !r.premier) continue;
    const o = orient(r, lobby);
    if(!o) continue;
    const tot = o.rw + o.rl;
    ms.push({ ...r, rw:o.rw, rl:o.rl, roster:o.roster, euJogou:o.euJogou,
      outcome: o.rw>o.rl ? 1 : (o.rl>o.rw ? 0 : 0.5),
      roundShare: tot>0 ? o.rw/tot : 0.5,
      wTime: Math.pow(2, -r.age/halfLife) });
  }
  for(const m of ms) m.q = P.wOutcome*m.outcome + P.wRoundShare*m.roundShare;
  const q1 = wmean(ms.filter(m=>m.outcome===1).map(m=>[m.q,m.wTime]));
  const q0 = wmean(ms.filter(m=>m.outcome===0).map(m=>[m.q,m.wTime]));
  const ok = q1!=null && q0!=null && (q1-q0) > 0.05;
  if(ok) for(const m of ms) m.q = Math.min(Math.max((m.q-q0)/(q1-q0),-0.2),1.2);
  return ms;
}

function rosterWeight(roster, lobby){
  let inter = 0; for(const x of roster) if(lobby.has(x)) inter++;
  const uni = new Set([...roster,...lobby]).size;
  const j = uni ? inter/uni : 1;
  return P.rosterFloor + (1-P.rosterFloor) * Math.pow(j, P.rosterGamma);
}

function perfIndex(m){
  if(!m.euJogou) return null;
  let s=0,w=0;
  if(m.k!=null && m.d!=null){ s += P.perf.kd * Math.min(m.k/Math.max(m.d,1),3)/3; w += P.perf.kd; }
  if(m.adr!=null){ s += P.perf.adr * Math.min(m.adr,150)/150; w += P.perf.adr; }
  if(m.rating!=null){ s += P.perf.rating * Math.min(m.rating,2)/2; w += P.perf.rating; }
  return w>1e-9 ? s/w : null;
}

function activeMaps(ms){
  const rec={}, all={};
  for(const m of ms){ all[m.map]=(all[m.map]||0)+1;
    if(m.age <= P.poolWindow) rec[m.map]=(rec[m.map]||0)+1; }
  const pool = Object.keys(rec).length ? rec : all;
  return Object.keys(pool).sort((a,b)=>pool[b]-pool[a]);
}

function rank(lobbyIds, halfLife){
  const lobby = new Set(lobbyIds);
  if(!lobby.size) return { maps:[], thetaG:0.5, total:0, vazio:true };
  const ms = build(halfLife, lobby);
  if(!ms.length) return { maps:[], thetaG:0.5, total:0, vazio:true };

  const thetaG = shrink(wmean(ms.map(m=>[m.q,m.wTime])) ?? 0.5,
                        kish(ms.map(m=>m.wTime)), 0.5, P.kGlobal);

  // forma individual: so existe quando VOCE esta no lobby (o CSStats nao
  // expoe as estatisticas por partida dos seus amigos)
  const temEu = lobby.has(EU);
  let mu=null, sd=0.02;
  if(temEu){
    const idxAll = ms.map(m=>[perfIndex(m), m.wTime]).filter(p=>p[0]!=null);
    mu = wmean(idxAll);
    if(mu!=null){
      const den = idxAll.reduce((s,[,w])=>s+w,0);
      sd = Math.max(Math.sqrt(idxAll.reduce((s,[v,w])=>s+w*(v-mu)**2,0)/(den||1)), 0.02);
    }
  }

  const out = activeMaps(ms).map(mp => {
    const onMap = ms.filter(m=>m.map===mp);
    const thetaM = shrink(wmean(onMap.map(m=>[m.q,m.wTime])) ?? thetaG,
                          kish(onMap.map(m=>m.wTime)), thetaG, P.kMap);

    const scored = onMap.map(m=>[m, m.wTime * rosterWeight(m.roster, lobby)]);
    const n3 = kish(scored.map(([,w])=>w));
    const thetaR = shrink(wmean(scored.map(([m,w])=>[m.q,w])) ?? thetaM,
                          n3, thetaM, P.kRoster);

    let Z = 0;
    if(temEu && mu!=null){
      const vals = onMap.map(m=>[perfIndex(m),m.wTime]).filter(p=>p[0]!=null);
      if(vals.length){
        const zn = kish(vals.map(([,w])=>w));
        Z = ((wmean(vals)-mu)/sd) * (zn/(zn+P.formShrink));
      }
    }

    const p = sigmoid(logit(thetaR) + P.formBeta * Z);
    const se = n3 > 1e-9 ? Math.sqrt(Math.max(p*(1-p),1e-6)/n3) : 0.5;
    const exact = onMap.filter(m =>
      m.roster.size===lobby.size && [...lobby].every(x=>m.roster.has(x)));

    return {
      map:mp, p, low:Math.max(0,p-P.z*se), high:Math.min(1,p+P.z*se),
      nEff:n3, games:onMap.length,
      exW:exact.filter(m=>m.outcome===1).length,
      exL:exact.filter(m=>m.outcome===0).length,
      conf: n3<3?"sem dados":n3<8?"baixa":n3<20?"media":"alta",
      thetaG, thetaM, thetaR, Z, formPP:(p-thetaR)*100, temEu,
      wTot: onMap.filter(m=>m.outcome===1).length,
      lTot: onMap.filter(m=>m.outcome===0).length,
    };
  });

  out.sort((a,b)=> b.p-a.p || b.nEff-a.nEff);
  return { maps:out, thetaG, total:ms.length };
}
